#!/usr/bin/env python3
"""
convert_and_validate_inp.py

Script GOP CHUNG normalize_inp.py + validate_inp.py de chi can chay 1 lenh
Python la vua CONVERT file .inp xuat tu HyperMesh 2022 (dinh dang moi, dung
"name pool": ELSET tach rieng khoi *ELEMENT, ten set bi gan prefix kieu
"P15;P15;P15;..." hoac "S39;...") ve lai dung cu phap giong ban xuat tu
HyperMesh 14.0, VUA TU DONG KIEM TRA (validate) lai ket qua convert, in
bao cao PASS/FAIL ro rang.

===========================================================================
PHAN 1 -- CONVERT (noi dung goc: normalize_inp.py)
===========================================================================
Nhung viec phan CONVERT lam:
  1. Doc file .inp, tach thanh cac "card" (dong keyword + cac dong du lieu
     theo sau). Dong comment "**" bi loai bo hoan toan khoi output.
  2. Voi moi *SOLID SECTION, doc ten ELSET no tham chieu toi -> day la danh
     sach "component-elset" can duoc inline lai vao *ELEMENT.
  3. Voi moi *ELSET tren, doc list ID phan tu no dai dien (ho tro ca dang
     liet ke truc tiep lan GENERATE start-stop-step).
  4. Voi moi block *ELEMENT (biet so node/record qua TYPE), tach thanh tung
     "record" (id + cac node), roi GOM cac record lien tiep co cung
     "chu so huu" (component-elset chua ID do) thanh 1 block con, gan
     ELSET=<ten_da_lam_sach> cho block con do. Record khong thuoc component-
     elset nao thi giu nguyen khong ELSET.
  5. Sau khi xu ly HET cac block *ELEMENT, elset nao co toan bo ID da duoc
     "hut" het vao cac block con (khong con sot) thi block *ELSET rieng cua
     no bi XOA (vi da thanh redundant/inline). Elset khong khop het (vd set
     gop nhieu component nhu ALL_MASSIVE_ELEMENTS) thi GIU NGUYEN dang
     *ELSET rieng, chi lam sach ten (bo prefix pool).
  6. Lam sach prefix "Pxx;.../Sxx;..." (ke ca khi bi lap chuoi nhieu lan,
     vd "P15;P15;P15;Upper" -> "Upper") khoi MOI ten set con lai duoc tham
     chieu: *SOLID SECTION, *ELSET, *SURFACE, *NSET...
  7. Moi keyword (vd *Surface) duoc chuan hoa VIET HOA lai (*SURFACE).

===========================================================================
PHAN 2 -- VALIDATE (noi dung goc: validate_inp.py)
===========================================================================
Script kiem tra DOC LAP voi phan CONVERT o tren -- KHONG dung lai ket qua
grouping cua no, ma tu doc lai file GOC (truoc convert) va file OUTPUT
(sau convert) de tu suy ra xem viec gan ELSET/inline co dung khong.

CAC PHEP KIEM TRA:
  1. BAO TOAN PHAN TU: tap hop ID phan tu trong OUTPUT phai giong HET tap
     hop ID phan tu trong INPUT (khong mat, khong trung, khong bia them).
  2. BAO TOAN NODE: tap hop ID node trong OUTPUT phai giong INPUT.
  3. GAN DUNG COMPONENT: voi tung *SOLID SECTION trong file GOC (tim ra
     component-elset can inline), tu tinh lai tap ID cua elset do TU FILE
     GOC, roi so sanh voi tap ID nam trong (cac) block *ELEMENT co
     ELSET=ten_do trong OUTPUT. Neu lech dau -> bao chinh xac ID nao bi
     gan sai / bi thieu / bi thua.
  4. KHONG CON THAM CHIEU TREO: moi *SOLID SECTION trong OUTPUT tham chieu
     ELSET nao thi ELSET do phai ton tai (hoac la 1 *ELEMENT block co
     ELSET trung ten, hoac 1 *ELSET block rieng). (*SURFACE NAME khong
     tinh la tham chieu vi do la ten DANG DUOC DINH NGHIA, khong phai
     tra cuu toi ELSET co san.)
  5. DO DAI DONG: khong dong nao trong OUTPUT vuot 256 ky tu (gioi han cu
     phap Abaqus).
  6. Khong con ten nao dinh dang "Pxx;..." hoac "Sxx;..." sot lai trong
     OUTPUT (nghia la buoc lam sach ten chay het, khong bi sot).

===========================================================================
CACH DUNG (chi 1 lenh, chay ca convert + validate):
    python3 convert_and_validate_inp.py input_2022.inp output_normalized.inp

Thoat voi exit code 0 neu VALIDATE PASS het, exit code 1 neu co FAIL -- de
co the gan vao quy trinh tu dong.
===========================================================================
"""

import re
import sys
from dataclasses import dataclass, field


# ===========================================================================
# PHAN 1 -- CONVERT
# ===========================================================================

# ---------------------------------------------------------------------------
# Buoc 1: doc file thanh danh sach "card"
# ---------------------------------------------------------------------------

@dataclass
class Card:
    header: str
    keyword: str
    params: dict
    data_lines: list = field(default_factory=list)
    is_comment: bool = False
    removed: bool = False


def parse_keyword_line(line: str):
    content = line.strip()
    if content.endswith(('\\', '\r')):
        content = content.rstrip('\\\r')
    parts = [p.strip() for p in content.lstrip('*').split(',')]
    keyword = parts[0].upper()
    params = {}
    for p in parts[1:]:
        if not p:
            continue
        if '=' in p:
            k, v = p.split('=', 1)
            params[k.strip().upper()] = v.strip()
        else:
            params[p.strip().upper()] = None
    return keyword, params


def load_cards(path: str):
    print(f'[1/4] Dang doc file: {path} ...', flush=True)
    with open(path, 'r', encoding='utf-8', errors='replace') as f:
        raw_lines = f.readlines()
    print(f'      Doc xong {len(raw_lines):,} dong.', flush=True)

    cards = []
    current = None
    for idx, raw in enumerate(raw_lines):
        if idx and idx % 200000 == 0:
            print(f'      ... da parse {idx:,}/{len(raw_lines):,} dong', flush=True)
        line = raw.rstrip('\n').rstrip('\r')
        stripped = line.strip()
        if stripped.startswith('**'):
            cards.append(Card(header=line, keyword='__COMMENT__', params={},
                               is_comment=True))
            current = None
            continue
        if stripped.startswith('*'):
            keyword, params = parse_keyword_line(stripped)
            current = Card(header=line, keyword=keyword, params=params)
            cards.append(current)
            continue
        if current is not None:
            current.data_lines.append(line)
        else:
            cards.append(Card(header=line, keyword='__RAW__', params={}))
    print(f'[1/4] Da tach thanh {len(cards):,} card.', flush=True)
    return cards


# ---------------------------------------------------------------------------
# Buoc 2: lam sach ten bi gan prefix "name pool"
# ---------------------------------------------------------------------------

POOL_PREFIX_RE = re.compile(r'^[A-Za-z]+\d+(?::[A-Za-z]+\d+)?;')


def extract_component_name_from_comment(header):
    """Neu dong comment (bat dau bang '**') la mot dong '**HW_COMPONENT
    ID=... COLOR=... NAME=<ten>', tra ve <ten> (raw, chua lam sach prefix).
    Dong nay dung whitespace de tach cot (khong dung dau phay nhu cac
    keyword Abaqus binh thuong), nen phai tu tach rieng, khong dung
    parse_keyword_line()."""
    if not header:
        return None
    content = header.strip()
    if not content.startswith('**'):
        return None
    body = content.lstrip('*').strip()
    parts = body.split()
    if not parts or parts[0].upper() != 'HW_COMPONENT':
        return None
    for p in parts[1:]:
        if p.upper().startswith('NAME='):
            return p.split('=', 1)[1].strip()
    return None


def clean_pool_name(raw_name: str) -> str:
    """Bo TAT CA prefix pool o dau ten, ke ca khi bi lap chuoi nhieu lan
    (vd 'P15;P15;P15;Upper' -> 'Upper'). POOL_PREFIX_RE.sub() chi khop
    duoc 1 lan vi pattern neo bang ^, nen phai lap cho den khi khong con
    khop nua (tranh vong lap vo han bang cach dung lai khi chuoi khong
    doi sau 1 lan thay the)."""
    if raw_name is None:
        return raw_name
    name = raw_name.strip()
    while True:
        new_name = POOL_PREFIX_RE.sub('', name, count=1)
        if new_name == name:
            break
        name = new_name
    return name


# ---------------------------------------------------------------------------
# Buoc 3: so node theo TYPE, de tach dung tung record trong *ELEMENT
# ---------------------------------------------------------------------------

ELEMENT_NODE_COUNTS = {
    'C3D4': 4, 'C3D4H': 4,
    'C3D6': 6, 'C3D6H': 6,
    'C3D8': 8, 'C3D8H': 8, 'C3D8I': 8, 'C3D8IH': 8, 'C3D8R': 8, 'C3D8RH': 8,
    'C3D8T': 8,
    'C3D10': 10, 'C3D10H': 10, 'C3D10M': 10, 'C3D10MH': 10, 'C3D10I': 10,
    'C3D10MT': 10,
    'C3D15': 15, 'C3D15H': 15,
    'C3D20': 20, 'C3D20H': 20, 'C3D20R': 20, 'C3D20RH': 20,
    'S3': 3, 'S3R': 3, 'STRI3': 3,
    'S4': 4, 'S4R': 4, 'S4RS': 4,
    'S8R': 8, 'S8R5': 8, 'STRI65': 6,
    'T3D2': 2, 'T2D2': 2,
    'B21': 2, 'B31': 2, 'B22': 3, 'B32': 3,
}


def guess_node_count(type_name):
    if not type_name:
        return None
    t = type_name.upper()
    if t in ELEMENT_NODE_COUNTS:
        return ELEMENT_NODE_COUNTS[t]
    m = re.match(r'C3D(\d+)', t)
    if m:
        return int(m.group(1))
    m = re.match(r'C(?:AX|PE|PS)(\d+)', t)
    if m:
        return int(m.group(1))
    m = re.match(r'S(\d+)', t)
    if m:
        return int(m.group(1))
    return None


# ---------------------------------------------------------------------------
# Buoc 4: tach *ELSET (list hoac GENERATE) thanh tap ID
# ---------------------------------------------------------------------------

def extract_ids_from_data_lines(data_lines, generate=False):
    ids = set()
    if generate:
        for dl in data_lines:
            nums = [n.strip() for n in dl.split(',') if n.strip()]
            if len(nums) >= 2:
                start, stop = int(nums[0]), int(nums[1])
                step = int(nums[2]) if len(nums) >= 3 and nums[2] else 1
                ids.update(range(start, stop + 1, step))
        return ids
    for dl in data_lines:
        for tok in dl.split(','):
            tok = tok.strip()
            if tok:
                try:
                    ids.add(int(tok))
                except ValueError:
                    pass
    return ids


# ---------------------------------------------------------------------------
# Buoc 5: tach *ELEMENT thanh tung "record" (id + cac dong text goc cua no)
# ---------------------------------------------------------------------------

def parse_element_records(data_lines, node_count):
    """Tra ve list cac dict {'id': int, 'lines': [raw_line,...]}.
    Toi uu: gan moi token voi chi so dong nguon cua no ngay khi tokenize
    (O(so_token)), roi cat theo tung record bang slicing -- KHONG quet lai
    toan bo danh sach dong cho tung record (tranh O(so_record x so_dong),
    rat cham voi file lon hang tram nghin phan tu)."""
    all_tokens = []
    token_line_idx = []
    for i, dl in enumerate(data_lines):
        toks = [t.strip() for t in dl.split(',') if t.strip()]
        all_tokens.extend(toks)
        token_line_idx.extend([i] * len(toks))

    rec_len = node_count + 1
    records = []
    num_records = len(all_tokens) // rec_len
    for r in range(num_records):
        start = r * rec_len
        end = start + rec_len
        first_line = token_line_idx[start]
        last_line = token_line_idx[end - 1]
        rec_lines = data_lines[first_line:last_line + 1]
        try:
            rec_id = int(all_tokens[start])
        except ValueError:
            rec_id = None
        records.append({'id': rec_id, 'lines': rec_lines})

    leftover = len(all_tokens) % rec_len
    return records, leftover


# ---------------------------------------------------------------------------
# Buoc 6: xu ly chinh (convert)
# ---------------------------------------------------------------------------

def normalize(cards):
    print('[2/4] Dang doc *ELSET va *SOLID SECTION ...', flush=True)
    elset_defs = {}
    for c in cards:
        if c.keyword == 'ELSET':
            raw_name = c.params.get('ELSET')
            generate = 'GENERATE' in c.params
            ids = extract_ids_from_data_lines(c.data_lines, generate=generate)
            elset_defs[raw_name] = {'card': c, 'ids': ids}
    print(f'      Tim thay {len(elset_defs):,} khoi *ELSET.', flush=True)

    solid_section_names = set()
    for c in cards:
        if c.keyword == 'SOLID SECTION':
            n = c.params.get('ELSET')
            if n:
                solid_section_names.add(n)
    print(f'      Tim thay {len(solid_section_names):,} *SOLID SECTION '
          f'(component-elset can inline).', flush=True)

    id_to_elset_name = {}
    ambiguous_ids = set()
    for raw_name in solid_section_names:
        info = elset_defs.get(raw_name)
        if not info:
            continue
        for eid in info['ids']:
            if eid in id_to_elset_name and id_to_elset_name[eid] != raw_name:
                ambiguous_ids.add(eid)
            id_to_elset_name[eid] = raw_name
    if ambiguous_ids:
        print(f'  [canh bao] {len(ambiguous_ids)} element ID xuat hien trong '
              f'nhieu hon 1 component-elset cung luc -- kiem tra lai du lieu.',
              flush=True)
    print(f'      Da lap bang tra cuu cho {len(id_to_elset_name):,} element ID.',
          flush=True)

    consumed_ids_per_elset = {name: set() for name in solid_section_names}

    print('[3/4] Dang tach/gom lai cac block *ELEMENT ...', flush=True)
    element_card_count = 0
    total_record_count = 0
    new_cards = []
    current_component = None  # ten component (raw) tu dong **HW_COMPONENT gan nhat
    hw_component_used = False
    for c in cards:
        if c.keyword == '__COMMENT__':
            name = extract_component_name_from_comment(c.header)
            if name:
                current_component = name
            new_cards.append(c)
            continue

        if c.keyword != 'ELEMENT':
            new_cards.append(c)
            continue

        element_card_count += 1
        type_name = c.params.get('TYPE')
        node_count = guess_node_count(type_name)
        if node_count is None:
            print(f'  [canh bao] Khong doan duoc so node cho TYPE={type_name!r} '
                  f'-> giu nguyen block goc, KHONG tach/inline ELSET cho block nay.',
                  flush=True)
            new_cards.append(c)
            continue

        records, leftover = parse_element_records(c.data_lines, node_count)
        total_record_count += len(records)
        print(f'      Block #{element_card_count}: TYPE={type_name}, '
              f'{len(records):,} phan tu ...', flush=True)
        if leftover:
            print(f'  [canh bao] Block *ELEMENT,TYPE={type_name} co du lieu le '
                  f'({leftover} token) khong chia het theo so node={node_count} '
                  f'-> co the doc sai record cuoi.', flush=True)

        if c.params.get('ELSET'):
            new_cards.append(c)
            continue

        # Chu so huu mac dinh cua CA block nay: component duoc khai bao qua
        # dong **HW_COMPONENT ngay truoc block *ELEMENT nay (nguon CHINH,
        # vi file HyperMesh 2022 thuc te thuong KHONG co *ELSET rieng cho
        # tung component). Neu 1 ID cu the co mat trong bang tra cuu id_to_
        # elset_name (tu *ELSET thuc su khop *SOLID SECTION -- nguon PHU,
        # legacy) thi uu tien nguon do cho rieng ID ay.
        block_default_owner = current_component
        if block_default_owner is not None:
            hw_component_used = True

        groups = []
        for rec in records:
            owner = id_to_elset_name.get(rec['id'], block_default_owner)
            if groups and groups[-1][0] == owner:
                groups[-1][1].append(rec)
            else:
                groups.append((owner, [rec]))

        if len(groups) == 1 and groups[0][0] is None:
            new_cards.append(c)
            continue

        for owner, recs in groups:
            sub_params = dict(c.params)
            if owner is not None:
                sub_params['ELSET'] = clean_pool_name(owner)
                if owner in consumed_ids_per_elset:
                    consumed_ids_per_elset[owner].update(
                        r['id'] for r in recs if r['id'] is not None)
            sub_card = Card(header=c.header, keyword='ELEMENT', params=sub_params)
            for r in recs:
                sub_card.data_lines.extend(r['lines'])
            new_cards.append(sub_card)

    print(f'      Da xu ly {element_card_count:,} block *ELEMENT '
          f'({total_record_count:,} phan tu tong cong).', flush=True)
    if hw_component_used:
        print('      Da dung dong **HW_COMPONENT lam nguon chinh de gan '
              'ELSET cho cac block khong co *ELSET rieng.', flush=True)

    matched_elset_names = set()
    for name in solid_section_names:
        info = elset_defs.get(name)
        if not info:
            continue
        if info['ids'] and consumed_ids_per_elset[name] == info['ids']:
            info['card'].removed = True
            matched_elset_names.add(name)

    NAME_PARAM_KEYS = ('ELSET', 'NSET', 'NAME')
    for c in new_cards:
        if c.removed:
            continue
        for key in NAME_PARAM_KEYS:
            if key in c.params and c.params[key]:
                c.params[key] = clean_pool_name(c.params[key])

    return new_cards, matched_elset_names


# ---------------------------------------------------------------------------
# Buoc 7: ghi lai header + file output
# ---------------------------------------------------------------------------

def rebuild_header(card: Card, original_param_order):
    parts = ['*' + card.keyword]
    order = list(original_param_order)
    for k in card.params:
        if k not in order:
            if k == 'ELSET' and 'TYPE' in order:
                idx = order.index('TYPE') + 1
                order.insert(idx, k)
            else:
                order.append(k)
    for k in order:
        if k not in card.params:
            continue
        v = card.params[k]
        parts.append(k if v is None else f'{k}={v}')
    return ', '.join(parts)


def write_output(cards, out_path):
    print(f'[4/4] Dang ghi file output: {out_path} ...', flush=True)
    with open(out_path, 'w', encoding='utf-8') as f:
        in_header = True
        for idx, c in enumerate(cards):
            if idx and idx % 200000 == 0:
                print(f'      ... da ghi {idx:,}/{len(cards):,} card', flush=True)
            if c.removed:
                continue
            if in_header:
                if c.keyword in ('__COMMENT__', '__RAW__'):
                    # Con trong khoi header dau file (truoc keyword Abaqus
                    # that su dau tien, vd *NODE) -> giu nguyen, KHONG xoa.
                    f.write(c.header + '\n')
                    continue
                # Gap keyword Abaqus that su dau tien -> ket thuc header,
                # tu day tro di comment "**" (vd **HW_COMPONENT) bi xoa
                # nhu binh thuong. Chen 1 dong ghi chu ngay sau header.
                f.write('** Converted by Fukada tool\n')
                in_header = False
            if c.keyword == '__COMMENT__':
                continue
            if c.keyword == '__RAW__':
                f.write(c.header + '\n')
                continue
            _, original_params = parse_keyword_line(c.header)
            header = rebuild_header(c, list(original_params.keys()))
            f.write(header + '\n')
            for dl in c.data_lines:
                f.write(dl + '\n')
    print('[4/4] Ghi file xong.', flush=True)


# ===========================================================================
# PHAN 2 -- VALIDATE
# ===========================================================================

def collect_element_ids_by_block(cards):
    """Doc lap voi normalize(): duyet tung *ELEMENT block, tra ve
    (all_ids_set, list_of_blocks) voi moi block la {'elset': ten_hoac_None,
    'ids': set}. Dung guess_node_count/parse_element_records o PHAN 1 (chi
    de tokenize dung), nhung KHONG dung ket qua grouping cua normalize()."""
    all_ids = set()
    duplicate_ids = set()
    blocks = []
    for c in cards:
        if c.keyword != 'ELEMENT':
            continue
        node_count = guess_node_count(c.params.get('TYPE'))
        if node_count is None:
            print(f'  [validate CANH BAO] Bo qua kiem tra block TYPE='
                  f'{c.params.get("TYPE")!r} (khong biet so node).')
            continue
        records, leftover = parse_element_records(c.data_lines, node_count)
        ids = set()
        for r in records:
            if r['id'] is None:
                continue
            if r['id'] in all_ids:
                duplicate_ids.add(r['id'])
            all_ids.add(r['id'])
            ids.add(r['id'])
        blocks.append({'elset': c.params.get('ELSET'), 'ids': ids,
                        'type': c.params.get('TYPE')})
    return all_ids, duplicate_ids, blocks


def collect_node_ids(cards):
    ids = set()
    for c in cards:
        if c.keyword == 'NODE':
            for dl in c.data_lines:
                tok = dl.split(',')[0].strip()
                if tok:
                    try:
                        ids.add(int(tok))
                    except ValueError:
                        pass
    return ids


def collect_elset_ids_from_original(cards):
    """Tu file GOC: raw_name -> set ID (doc truc tiep tu *ELSET, doc lap
    voi normalize())."""
    out = {}
    for c in cards:
        if c.keyword == 'ELSET':
            raw_name = c.params.get('ELSET')
            generate = 'GENERATE' in c.params
            ids = extract_ids_from_data_lines(c.data_lines, generate=generate)
            out[raw_name] = ids
    return out


def collect_element_ids_by_hw_component(cards):
    """Doc lap voi normalize(): tu file GOC, duyet cards theo THU TU, theo
    doi dong comment '**HW_COMPONENT ... NAME=<ten>' gan nhat, roi gan
    TOAN BO 1 block *ELEMENT (khong co ELSET rieng) cho component do. Day
    la nguon "expected" DUNG VOI CAU TRUC FILE THUC TE (HyperMesh 2022
    thuong KHONG co *ELSET rieng cho tung component, chi co dong comment
    HW_COMPONENT dung lam nguon xac dinh chu so huu).
    Tra ve: clean_component_name -> set ID."""
    result = {}
    current_component = None
    for c in cards:
        if c.keyword == '__COMMENT__':
            name = extract_component_name_from_comment(c.header)
            if name:
                current_component = name
            continue
        if c.keyword != 'ELEMENT':
            continue
        node_count = guess_node_count(c.params.get('TYPE'))
        if node_count is None:
            continue
        records, _leftover = parse_element_records(c.data_lines, node_count)
        owner_raw = c.params.get('ELSET') or current_component
        if owner_raw is None:
            continue
        clean_name = clean_pool_name(owner_raw)
        bucket = result.setdefault(clean_name, set())
        for r in records:
            if r['id'] is not None:
                bucket.add(r['id'])
    return result


def collect_solid_section_names(cards):
    return {c.params.get('ELSET') for c in cards
            if c.keyword == 'SOLID SECTION' and c.params.get('ELSET')}


def all_defined_set_names(cards):
    """Ten set duoc DINH NGHIA trong file (lam key tra cuu ton tai)."""
    names = set()
    for c in cards:
        if c.keyword == 'ELSET' and c.params.get('ELSET'):
            names.add(c.params['ELSET'])
        if c.keyword == 'ELEMENT' and c.params.get('ELSET'):
            names.add(c.params['ELSET'])
    return names


def all_referenced_set_names(cards):
    """*SURFACE NAME khong tinh la tham chieu vi do la ten DANG DUOC DINH
    NGHIA (bang mot bo mat moi), khong phai tra cuu toi mot ELSET co san."""
    names = set()
    for c in cards:
        if c.keyword == 'SOLID SECTION' and c.params.get('ELSET'):
            names.add(c.params['ELSET'])
    return names


def check_line_lengths(path, limit=256):
    bad = []
    with open(path, 'r', encoding='utf-8', errors='replace') as f:
        for i, line in enumerate(f, start=1):
            if len(line.rstrip('\n').rstrip('\r')) > limit:
                bad.append(i)
    return bad


def find_leftover_pool_prefixes(cards):
    hits = []
    for c in cards:
        for key in ('ELSET', 'NSET', 'NAME'):
            v = c.params.get(key)
            if v and POOL_PREFIX_RE.match(v):
                hits.append((c.header, key, v))
    return hits


def validate(orig_cards, out_path):
    """Chay toan bo 6 phep kiem tra, in bao cao PASS/FAIL. Tra ve True neu
    PASS het, False neu co it nhat 1 FAIL."""
    print(f'Dang doc lai file output de validate: {out_path}')
    out_cards = load_cards(out_path)

    failures = []
    warnings = []

    # --- 1. Bao toan phan tu ---
    orig_elem_ids, orig_dups, orig_blocks = collect_element_ids_by_block(orig_cards)
    out_elem_ids, out_dups, out_blocks = collect_element_ids_by_block(out_cards)

    if orig_dups:
        warnings.append(f'File GOC da co san {len(orig_dups)} ID phan tu bi trung '
                         f'(khong lien quan toi convert).')
    if out_dups:
        failures.append(f'OUTPUT co {len(out_dups)} ID phan tu bi TRUNG LAP sau khi '
                         f'tach block (loi convert): {sorted(list(out_dups))[:10]} ...')

    missing = orig_elem_ids - out_elem_ids
    extra = out_elem_ids - orig_elem_ids
    if missing:
        failures.append(f'OUTPUT bi THIEU {len(missing)} phan tu so voi file goc: '
                         f'{sorted(list(missing))[:10]} ...')
    if extra:
        failures.append(f'OUTPUT co THEM {len(extra)} phan tu la KHONG co trong file goc: '
                         f'{sorted(list(extra))[:10]} ...')
    if not missing and not extra and not out_dups:
        print(f'[PASS] Bao toan phan tu: {len(orig_elem_ids):,} phan tu khop hoan toan.')

    # --- 2. Bao toan node ---
    orig_node_ids = collect_node_ids(orig_cards)
    out_node_ids = collect_node_ids(out_cards)
    if orig_node_ids != out_node_ids:
        failures.append(f'Tap ID node OUTPUT khac file goc (thieu '
                         f'{len(orig_node_ids - out_node_ids)}, thua '
                         f'{len(out_node_ids - orig_node_ids)}).')
    else:
        print(f'[PASS] Bao toan node: {len(orig_node_ids):,} node khop hoan toan.')

    # --- 3. Gan dung component (so voi *SOLID SECTION trong file GOC) ---
    orig_elset_ids = collect_elset_ids_from_original(orig_cards)
    orig_solid_names = collect_solid_section_names(orig_cards)
    orig_hw_component_ids = collect_element_ids_by_hw_component(orig_cards)

    out_ids_by_clean_elset = {}
    for b in out_blocks:
        if not b['elset']:
            continue
        out_ids_by_clean_elset.setdefault(b['elset'], set()).update(b['ids'])

    mismatch_count = 0
    checked_count = 0
    for raw_name in sorted(orig_solid_names):
        clean_name = clean_pool_name(raw_name)
        info = orig_elset_ids.get(raw_name)
        source = None
        if info is not None:
            expected_ids = info
            source = '*ELSET'
        else:
            expected_ids = orig_hw_component_ids.get(clean_name)
            source = '**HW_COMPONENT'
        if expected_ids is None:
            warnings.append(f'*SOLID SECTION tham chieu ELSET={raw_name!r} nhung '
                             f'khong tim thay dinh nghia *ELSET LAN dong '
                             f'**HW_COMPONENT tuong ung trong file goc.')
            continue
        checked_count += 1
        actual_ids = out_ids_by_clean_elset.get(clean_name, set())
        if actual_ids != expected_ids:
            mismatch_count += 1
            miss = expected_ids - actual_ids
            extra_ids = actual_ids - expected_ids
            detail = []
            if miss:
                detail.append(f'thieu {len(miss)} ID (vd {sorted(list(miss))[:5]})')
            if extra_ids:
                detail.append(f'thua {len(extra_ids)} ID (vd {sorted(list(extra_ids))[:5]})')
            failures.append(f'Component "{clean_name}" (nguon doi chieu: {source}): '
                             f'gan SAI trong OUTPUT -- {", ".join(detail)}.')
    if mismatch_count == 0 and checked_count:
        print(f'[PASS] Gan dung component: {checked_count:,}/{len(orig_solid_names):,} '
              f'component deu khop chinh xac tung ID.')
    elif mismatch_count == 0 and not checked_count:
        print(f'[PASS] Gan dung component: khong co component nao doi chieu duoc '
              f'(xem canh bao).')

    # --- 4. Khong con tham chieu treo ---
    defined = all_defined_set_names(out_cards)
    referenced = all_referenced_set_names(out_cards)
    dangling = referenced - defined
    if dangling:
        failures.append(f'OUTPUT co {len(dangling)} ten set duoc tham chieu nhung '
                         f'KHONG duoc dinh nghia o dau ca: {sorted(dangling)}')
    else:
        print(f'[PASS] Khong co tham chieu treo ({len(referenced):,} ten duoc kiem tra).')

    # --- 5. Do dai dong ---
    bad_lines = check_line_lengths(out_path)
    if bad_lines:
        failures.append(f'OUTPUT co {len(bad_lines)} dong vuot 256 ky tu '
                         f'(dong: {bad_lines[:10]} ...) -- vi pham cu phap Abaqus.')
    else:
        print('[PASS] Khong dong nao vuot 256 ky tu.')

    # --- 6. Khong con sot prefix pool ---
    leftover = find_leftover_pool_prefixes(out_cards)
    if leftover:
        failures.append(f'OUTPUT con sot {len(leftover)} ten chua duoc lam sach prefix '
                         f'pool: {[(k, v) for _, k, v in leftover[:5]]}')
    else:
        print('[PASS] Khong con sot prefix "Pxx;" / "Sxx;" nao trong ten set.')

    # --- Tong ket ---
    print()
    if warnings:
        print(f'{len(warnings)} canh bao (khong lam FAIL):')
        for w in warnings:
            print(f'  [canh bao] {w}')
        print()

    if failures:
        print(f'===> VALIDATE FAIL: {len(failures)} loi phat hien =================')
        for f_ in failures:
            print(f'  [FAIL] {f_}')
        print('===============================================================')
        return False
    else:
        print('===> VALIDATE PASS: khong phat hien loi nao. =====================')
        return True


