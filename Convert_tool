def main():
    if len(sys.argv) != 3:
        print('Cach dung: python3 convert_and_validate_inp.py input.inp output.inp')
        sys.exit(1)

    in_path, out_path = sys.argv[1], sys.argv[2]

    print('========================= BUOC 1: CONVERT ==========================')
    orig_cards = load_cards(in_path)
    new_cards, matched = normalize(orig_cards)
    write_output(new_cards, out_path)

    print(f'Da xu ly {in_path} -> {out_path}')
    print(f'So ELSET duoc inline lai vao *ELEMENT (va xoa block rieng): {len(matched)}')
    for name in sorted(matched):
        print(f'   - {name}  ->  {clean_pool_name(name)}')

    print()
    print('========================= BUOC 2: VALIDATE =========================')
    # Doc lai file GOC tu dau (doc lap voi cards da bi normalize() sua doi
    # tai cho, dam bao validate luon dung du lieu "sach" tu file goc).
    fresh_orig_cards = load_cards(in_path)
    ok = validate(fresh_orig_cards, out_path)

    sys.exit(0 if ok else 1)


