#!/usr/bin/env python3
"""
normalize_inp.py

Chuan hoa file Abaqus .inp xuat tu HyperMesh 2022 (dinh dang moi, dung
"name pool": ELSET tach rieng khoi *ELEMENT, ten set bi gan prefix kieu
"P15:P15;" hoac "S39;", va nhieu component CUNG TYPE bi GOP CHUNG vao 1
block *ELEMENT duy nhat) ve lai dang cu phap giong ban xuat tu HyperMesh
14.0 (moi component = 1 block *ELEMENT rieng, ELSET nhung truc tiep vao
dong *ELEMENT, ten set khong bi prefix).

Nhung viec tool nay lam:
  1. Doc file .inp, tach thanh cac "card" (dong keyword + cac dong du lieu
     theo sau).
  2. Voi moi *SOLID SECTION, doc ten ELSET no tham chieu toi -> day la danh
     sach "component-elset" can duoc inline lai vao *ELEMENT.
  3. Voi moi *ELSET tren, doc list ID phan tu no dai dien (ho tro ca dang
     liet ke truc tiep lan GENERATE start-stop-step).
  4. Voi moi block *ELEMENT (biet so node/record qua TYPE), tach thanh tung
     "record" (id + cac node), roi GOM cac record lien tiep co cung
     "chu so huu" (component-elset chua ID do) thanh 1 block con, gan
     ELSET=<ten_da_lam_sach> cho block con do. Record khong thuoc component-
     elset nao thi giu nguyen khong ELSET.
  5. Sau khi xu ly HET cac block *ELEMENT, elset nao co toan bo ID da duoc
     "hut" het vao cac block con (khong con sot) thi block *ELSET rieng cua
     no bi XOA (vi da thanh redundant/inline). Elset khong khop het (vd set
     gop nhieu component nhu ALL_MASSIVE_ELEMENTS) thi GIU NGUYEN dang
     *ELSET rieng, chi lam sach ten (bo prefix pool).
  6. Lam sach prefix "Pxx:Pxx;" / "Sxx;" khoi MOI ten set con lai duoc tham
     chieu: *SOLID SECTION, *ELSET, *SURFACE, *NSET...

CACH DUNG:
    python3 normalize_inp.py input_2022.inp output_normalized.inp

LUU Y:
  - Can biet so node/element cho tung TYPE de tach dung record (bang
    ELEMENT_NODE_COUNTS + fallback regex ben duoi). Neu gap TYPE la, script
    se in canh bao -- bao lai de bo sung.
  - De don gian, cac record duoc ghi lai giu nguyen dong text goc (khong
    bien dang whitespace), nhung neu 1 record von nam giua 2 dong (do
    HM chia record do lam 2), toan bo 2 dong do se di theo record khi tach
    block, dam bao khong lam vo cu phap continuation.
"""

import re
import sys
from dataclasses import dataclass, field


# ---------------------------------------------------------------------------
# Buoc 1: doc file thanh danh sach "card"
# ---------------------------------------------------------------------------

@dataclass
class Card:
    header: str
    keyword: str
    params: dict
    data_lines: list = field(default_factory=list)
    is_comment: bool = False
    removed: bool = False


def parse_keyword_line(line: str):
    content = line.strip()
    if content.endswith(('\\', '\r')):
        content = content.rstrip('\\\r')
    parts = [p.strip() for p in content.lstrip('*').split(',')]
    keyword = parts[0].upper()
    params = {}
    for p in parts[1:]:
        if not p:
            continue
        if '=' in p:
            k, v = p.split('=', 1)
            params[k.strip().upper()] = v.strip()
        else:
            params[p.strip().upper()] = None
    return keyword, params


def load_cards(path: str):
    print(f'[1/4] Dang doc file: {path} ...', flush=True)
    with open(path, 'r', encoding='utf-8', errors='replace') as f:
        raw_lines = f.readlines()
    print(f'      Doc xong {len(raw_lines):,} dong.', flush=True)

    cards = []
    current = None
    for idx, raw in enumerate(raw_lines):
        if idx and idx % 200000 == 0:
            print(f'      ... da parse {idx:,}/{len(raw_lines):,} dong', flush=True)
        line = raw.rstrip('\n').rstrip('\r')
        stripped = line.strip()
        if stripped.startswith('**'):
            cards.append(Card(header=line, keyword='__COMMENT__', params={},
                               is_comment=True))
            current = None
            continue
        if stripped.startswith('*'):
            keyword, params = parse_keyword_line(stripped)
            current = Card(header=line, keyword=keyword, params=params)
            cards.append(current)
            continue
        if current is not None:
            current.data_lines.append(line)
        else:
            cards.append(Card(header=line, keyword='__RAW__', params={}))
    print(f'[1/4] Da tach thanh {len(cards):,} card.', flush=True)
    return cards


# ---------------------------------------------------------------------------
# Buoc 2: lam sach ten bi gan prefix "name pool"
# ---------------------------------------------------------------------------

POOL_PREFIX_RE = re.compile(r'^[A-Za-z]+\d+(?::[A-Za-z]+\d+)?;')


def clean_pool_name(raw_name: str) -> str:
    if raw_name is None:
        return raw_name
    return POOL_PREFIX_RE.sub('', raw_name.strip())


# ---------------------------------------------------------------------------
# Buoc 3: so node theo TYPE, de tach dung tung record trong *ELEMENT
# ---------------------------------------------------------------------------

ELEMENT_NODE_COUNTS = {
    'C3D4': 4, 'C3D4H': 4,
    'C3D6': 6, 'C3D6H': 6,
    'C3D8': 8, 'C3D8H': 8, 'C3D8I': 8, 'C3D8IH': 8, 'C3D8R': 8, 'C3D8RH': 8,
    'C3D8T': 8,
    'C3D10': 10, 'C3D10H': 10, 'C3D10M': 10, 'C3D10MH': 10, 'C3D10I': 10,
    'C3D10MT': 10,
    'C3D15': 15, 'C3D15H': 15,
    'C3D20': 20, 'C3D20H': 20, 'C3D20R': 20, 'C3D20RH': 20,
    'S3': 3, 'S3R': 3, 'STRI3': 3,
    'S4': 4, 'S4R': 4, 'S4RS': 4,
    'S8R': 8, 'S8R5': 8, 'STRI65': 6,
    'T3D2': 2, 'T2D2': 2,
    'B21': 2, 'B31': 2, 'B22': 3, 'B32': 3,
}


def guess_node_count(type_name):
    if not type_name:
        return None
    t = type_name.upper()
    if t in ELEMENT_NODE_COUNTS:
        return ELEMENT_NODE_COUNTS[t]
    m = re.match(r'C3D(\d+)', t)
    if m:
        return int(m.group(1))
    m = re.match(r'C(?:AX|PE|PS)(\d+)', t)
    if m:
        return int(m.group(1))
    m = re.match(r'S(\d+)', t)
    if m:
        return int(m.group(1))
    return None


# ---------------------------------------------------------------------------
# Buoc 4: tach *ELSET (list hoac GENERATE) thanh tap ID
# ---------------------------------------------------------------------------

def extract_ids_from_data_lines(data_lines, generate=False):
    ids = set()
    if generate:
        for dl in data_lines:
            nums = [n.strip() for n in dl.split(',') if n.strip()]
            if len(nums) >= 2:
                start, stop = int(nums[0]), int(nums[1])
                step = int(nums[2]) if len(nums) >= 3 and nums[2] else 1
                ids.update(range(start, stop + 1, step))
        return ids
    for dl in data_lines:
        for tok in dl.split(','):
            tok = tok.strip()
            if tok:
                try:
                    ids.add(int(tok))
                except ValueError:
                    pass
    return ids


# ---------------------------------------------------------------------------
# Buoc 5: tach *ELEMENT thanh tung "record" (id + cac dong text goc cua no)
# ---------------------------------------------------------------------------

def parse_element_records(data_lines, node_count):
    """Tra ve list cac dict {'id': int, 'lines': [raw_line,...]}.
    Toi uu: gan moi token voi chi so dong nguon cua no ngay khi tokenize
    (O(so_token)), roi cat theo tung record bang slicing -- KHONG quet lai
    toan bo danh sach dong cho tung record (tranh O(so_record x so_dong),
    rat cham voi file lon hang tram nghin phan tu)."""
    all_tokens = []
    token_line_idx = []
    for i, dl in enumerate(data_lines):
        toks = [t.strip() for t in dl.split(',') if t.strip()]
        all_tokens.extend(toks)
        token_line_idx.extend([i] * len(toks))

    rec_len = node_count + 1
    records = []
    num_records = len(all_tokens) // rec_len
    for r in range(num_records):
        start = r * rec_len
        end = start + rec_len
        first_line = token_line_idx[start]
        last_line = token_line_idx[end - 1]
        rec_lines = data_lines[first_line:last_line + 1]
        try:
            rec_id = int(all_tokens[start])
        except ValueError:
            rec_id = None
        records.append({'id': rec_id, 'lines': rec_lines})

    leftover = len(all_tokens) % rec_len
    return records, leftover


# ---------------------------------------------------------------------------
# Buoc 6: xu ly chinh
# ---------------------------------------------------------------------------

def normalize(cards):
    print('[2/4] Dang doc *ELSET va *SOLID SECTION ...', flush=True)
    elset_defs = {}
    for c in cards:
        if c.keyword == 'ELSET':
            raw_name = c.params.get('ELSET')
            generate = 'GENERATE' in c.params
            ids = extract_ids_from_data_lines(c.data_lines, generate=generate)
            elset_defs[raw_name] = {'card': c, 'ids': ids}
    print(f'      Tim thay {len(elset_defs):,} khoi *ELSET.', flush=True)

    solid_section_names = set()
    for c in cards:
        if c.keyword == 'SOLID SECTION':
            n = c.params.get('ELSET')
            if n:
                solid_section_names.add(n)
    print(f'      Tim thay {len(solid_section_names):,} *SOLID SECTION '
          f'(component-elset can inline).', flush=True)

    id_to_elset_name = {}
    ambiguous_ids = set()
    for raw_name in solid_section_names:
        info = elset_defs.get(raw_name)
        if not info:
            continue
        for eid in info['ids']:
            if eid in id_to_elset_name and id_to_elset_name[eid] != raw_name:
                ambiguous_ids.add(eid)
            id_to_elset_name[eid] = raw_name
    if ambiguous_ids:
        print(f'  [canh bao] {len(ambiguous_ids)} element ID xuat hien trong '
              f'nhieu hon 1 component-elset cung luc -- kiem tra lai du lieu.',
              flush=True)
    print(f'      Da lap bang tra cuu cho {len(id_to_elset_name):,} element ID.',
          flush=True)

    consumed_ids_per_elset = {name: set() for name in solid_section_names}

    print('[3/4] Dang tach/gom lai cac block *ELEMENT ...', flush=True)
    element_card_count = 0
    total_record_count = 0
    new_cards = []
    for c in cards:
        if c.keyword != 'ELEMENT':
            new_cards.append(c)
            continue

        element_card_count += 1
        type_name = c.params.get('TYPE')
        node_count = guess_node_count(type_name)
        if node_count is None:
            print(f'  [canh bao] Khong doan duoc so node cho TYPE={type_name!r} '
                  f'-> giu nguyen block goc, KHONG tach/inline ELSET cho block nay.',
                  flush=True)
            new_cards.append(c)
            continue

        records, leftover = parse_element_records(c.data_lines, node_count)
        total_record_count += len(records)
        print(f'      Block #{element_card_count}: TYPE={type_name}, '
              f'{len(records):,} phan tu ...', flush=True)
        if leftover:
            print(f'  [canh bao] Block *ELEMENT,TYPE={type_name} co du lieu le '
                  f'({leftover} token) khong chia het theo so node={node_count} '
                  f'-> co the doc sai record cuoi.', flush=True)

        if c.params.get('ELSET'):
            new_cards.append(c)
            continue

        groups = []
        for rec in records:
            owner = id_to_elset_name.get(rec['id'])
            if groups and groups[-1][0] == owner:
                groups[-1][1].append(rec)
            else:
                groups.append((owner, [rec]))

        if len(groups) == 1 and groups[0][0] is None:
            new_cards.append(c)
            continue

        for owner, recs in groups:
            sub_params = dict(c.params)
            if owner is not None:
                sub_params['ELSET'] = clean_pool_name(owner)
                consumed_ids_per_elset[owner].update(
                    r['id'] for r in recs if r['id'] is not None)
            sub_card = Card(header=c.header, keyword='ELEMENT', params=sub_params)
            for r in recs:
                sub_card.data_lines.extend(r['lines'])
            new_cards.append(sub_card)

    print(f'      Da xu ly {element_card_count:,} block *ELEMENT '
          f'({total_record_count:,} phan tu tong cong).', flush=True)

    matched_elset_names = set()
    for name in solid_section_names:
        info = elset_defs.get(name)
        if not info:
            continue
        if info['ids'] and consumed_ids_per_elset[name] == info['ids']:
            info['card'].removed = True
            matched_elset_names.add(name)

    NAME_PARAM_KEYS = ('ELSET', 'NSET', 'NAME')
    for c in new_cards:
        if c.removed:
            continue
        for key in NAME_PARAM_KEYS:
            if key in c.params and c.params[key]:
                c.params[key] = clean_pool_name(c.params[key])

    return new_cards, matched_elset_names


# ---------------------------------------------------------------------------
# Buoc 7: ghi lai header + file output
# ---------------------------------------------------------------------------

def rebuild_header(card: Card, original_param_order):
    parts = ['*' + card.keyword]
    order = list(original_param_order)
    for k in card.params:
        if k not in order:
            if k == 'ELSET' and 'TYPE' in order:
                idx = order.index('TYPE') + 1
                order.insert(idx, k)
            else:
                order.append(k)
    for k in order:
        if k not in card.params:
            continue
        v = card.params[k]
        parts.append(k if v is None else f'{k}={v}')
    return ', '.join(parts)


def write_output(cards, out_path):
    print(f'[4/4] Dang ghi file output: {out_path} ...', flush=True)
    with open(out_path, 'w', encoding='utf-8') as f:
        for idx, c in enumerate(cards):
            if idx and idx % 200000 == 0:
                print(f'      ... da ghi {idx:,}/{len(cards):,} card', flush=True)
            if c.removed:
                continue
            if c.keyword in ('__COMMENT__', '__RAW__'):
                f.write(c.header + '\n')
                continue
            _, original_params = parse_keyword_line(c.header)
            header = rebuild_header(c, list(original_params.keys()))
            f.write(header + '\n')
            for dl in c.data_lines:
                f.write(dl + '\n')
    print('[4/4] Ghi file xong.', flush=True)


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

def main():
    if len(sys.argv) != 3:
        print('Cach dung: python3 normalize_inp.py input.inp output.inp')
        sys.exit(1)

    in_path, out_path = sys.argv[1], sys.argv[2]
    cards = load_cards(in_path)
    new_cards, matched = normalize(cards)
    write_output(new_cards, out_path)

    print(f'Da xu ly {in_path} -> {out_path}')
    print(f'So ELSET duoc inline lai vao *ELEMENT (va xoa block rieng): {len(matched)}')
    for name in sorted(matched):
        print(f'   - {name}  ->  {clean_pool_name(name)}')


if __name__ == '__main__':
    main()
