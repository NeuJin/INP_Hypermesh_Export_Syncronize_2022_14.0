EXPECTED_COMPONENT_ELEMENT_TYPE = {
    'Bush': 'C3D10M',
    'KnockPin': 'C3D10M',
    'Bolt_Penta': 'C3D6',
    'Bolt_Hexa': 'C3D8I',
    'Piston_Pin': 'C3D8I',
    'Lower': 'C3D8I',
    'Upper': 'C3D8I',
    'Cap_Shoulder': 'C3D10M',
    'Cap1': 'C3D10M',
    'Cap2': 'C3D10M',
    'Cap_Tetra': 'C3D10M',
    'Conrod_SE_Bore': 'C3D10M',
    'Conrod1': 'C3D10M',
    'Conrod2': 'C3D10M',
    'Conrod_Tetra': 'C3D10M',
}


def run_checktype(path):
    """Doc lai file (goc hoac da convert deu duoc, vi chi can **HW_COMPONENT
    + *ELEMENT TYPE), gom TYPE thuc te tung component tim thay, so voi
    EXPECTED_COMPONENT_ELEMENT_TYPE, in canh bao neu lech."""
    cards = load_cards(path)

    actual_types_by_component = {}  # clean_component_name -> set(TYPE)
    current_component = None
    for c in cards:
        if c.keyword == '__COMMENT__':
            name = extract_component_name_from_comment(c.header)
            if name:
                current_component = clean_pool_name(name)
            continue
        if c.keyword != 'ELEMENT':
            continue
        owner = c.params.get('ELSET')
        owner = clean_pool_name(owner) if owner else current_component
        if owner is None:
            continue
        actual_types_by_component.setdefault(owner, set()).add(c.params.get('TYPE'))

    print(f'Tim thay TYPE thuc te cho {len(actual_types_by_component)} component:\n')
    mismatch = 0
    for comp, expected_type in EXPECTED_COMPONENT_ELEMENT_TYPE.items():
        actual = actual_types_by_component.get(comp)
        if actual is None:
            print(f'  [KHONG TIM THAY] Component "{comp}" (mong doi {expected_type}) '
                  f'khong xuat hien trong file (kiem tra ten/khoang trang).')
            mismatch += 1
            continue
        if actual == {expected_type}:
            print(f'  [OK] {comp}: {expected_type}')
        else:
            print(f'  [LECH TYPE] {comp}: mong doi {expected_type}, thuc te tim thay '
                  f'{sorted(actual)}')
            mismatch += 1

    extra_components = set(actual_types_by_component) - set(EXPECTED_COMPONENT_ELEMENT_TYPE)
    if extra_components:
        print(f'\n  [CANH BAO] {len(extra_components)} component trong file KHONG co '
              f'trong bang mong doi (chua duoc khai bao truoc): {sorted(extra_components)}')

    print(f'\nTong ket: {mismatch} van de can kiem tra lai '
          f'(trong so {len(EXPECTED_COMPONENT_ELEMENT_TYPE)} component mong doi).')


def run_diagnostic(path):
    cards = load_cards(path)

    hw_names_raw = []
    for c in cards:
        if c.keyword == '__COMMENT__':
            name = extract_component_name_from_comment(c.header)
            if name:
                hw_names_raw.append(name)

    solid_names_raw = sorted({c.params.get('ELSET') for c in cards
                               if c.keyword == 'SOLID SECTION' and c.params.get('ELSET')})

    print(f'Tim thay {len(hw_names_raw)} dong **HW_COMPONENT co NAME=.')
    print(f'Tim thay {len(solid_names_raw)} ten *SOLID SECTION.\n')

    hw_clean_set = {clean_pool_name(n): n for n in hw_names_raw}

    print('So sanh tung ten *SOLID SECTION (sau khi lam sach prefix) voi '
          'danh sach ten HW_COMPONENT:\n')
    for raw in solid_names_raw:
        clean = clean_pool_name(raw)
        match = clean in hw_clean_set
        print(f'  SOLID SECTION raw : {raw!r}')
        print(f'  -> sau lam sach   : {clean!r}  (len={len(clean)})')
        print(f'     bytes          : {clean.encode("utf-8")!r}')
        if match:
            print(f'  [OK] khop voi HW_COMPONENT: {hw_clean_set[clean]!r}')
        else:
            # tim ten HW_COMPONENT gan giong nhat (case-insensitive / strip)
            close = [hw for hw in hw_clean_set
                     if hw.strip().lower() == clean.strip().lower()]
            if close:
                print(f'  [GAN KHOP nhung KHONG khop tuyet doi] ung vien: {close!r}')
                for hw in close:
                    print(f'     HW_COMPONENT bytes: {hw.encode("utf-8")!r} (len={len(hw)})')
            else:
                print('  [KHONG TIM THAY ung vien nao gan giong trong HW_COMPONENT]')
        print()


if __name__ == '__main__':
    if len(sys.argv) == 3 and sys.argv[1] == '--diag':
        run_diagnostic(sys.argv[2])
        sys.exit(0)
    if len(sys.argv) == 3 and sys.argv[1] == '--checktype':
        run_checktype(sys.argv[2])
        sys.exit(0)
    main()
